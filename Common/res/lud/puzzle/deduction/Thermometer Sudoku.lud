(game "Sudoku" 
    (players 1) 
    (equipment { 
        (board (square 9) (values Cell (range 1 9)))
        <Challenge:hints> 
        (regions {Columns Rows SubGrids})
    }) 
    (rules
        (start <Challenge:start>)
        
        (play (satisfy
        {
         (forAll Hint (< (from) (to)))
         (all Different)
         }
         ))
         
        (end (if (is Solved) (result P1 Win)))
    )
)

